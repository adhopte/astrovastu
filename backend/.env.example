# --- Server ---
PORT=4000
NODE_ENV=development
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d
DATABASE_PATH=data/astrovastu.db
UPLOAD_DIR=uploads
# Comma-separated origins allowed for the web build (native apps don't need CORS)
CORS_ORIGINS=

# --- Social login (leave blank to hide that button in the app) ---
# All OAuth client IDs your app uses: web, iOS and Android client IDs from Google Cloud Console
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Apple "aud" values: your iOS bundle id (and Services ID if using web sign-in)
APPLE_AUDIENCES=com.astrovastu.app

# Enables one-tap "Demo login" for local testing. Defaults to on outside production.
AUTH_DEV_LOGIN=true

# --- Optional AI (Claude) features: narrative readings + floor-plan room detection ---
ANTHROPIC_API_KEY=
# AI_ENABLED=true
# AI_MODEL=claude-opus-5

# Birth-place geocoding (Open-Meteo, no key required)
GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
